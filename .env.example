# Setup / 配置: docs/CONFIGURATION.en.md and docs/CONFIGURATION.zh-CN.md.
# Copy only for a NEW deployment; never overwrite an existing .env or data-encryption key.
# 仅新部署复制；不要覆盖已有 .env 或文件加密密钥。此示例绝不能填写真实凭据后提交。
# Independent Lingxu Discord Application credentials. Never reuse Lingji credentials.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Production multi-Guild: leave blank to sync global Guild-only commands.
# Development only: set one Guild ID for immediate test-Guild command sync.
DISCORD_TEST_GUILD_ID=

# Independent Lingxu paths. Docker Compose overrides these with container paths.
DATABASE_URL=sqlite+aiosqlite:///data/lingxu.db
DATA_ROOT=data/sessions
GLOSSARY_ROOT=data/glossaries
RUNTIME_TMP=.runtime
MODEL_CACHE_DIR=models

LOG_LEVEL=INFO

# Discord inbound DAVE readiness shared by formal Meeting and resident voice startup.
VOICE_DUPLEX_DAVE_READY_TIMEOUT_SECONDS=15

# Phase 2 persistence. Generate a new URL-safe 32-byte key for each deployment.
FILE_ENCRYPTION_KEY=
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_JOB_LOCK_SECONDS=600
WORKER_JOB_MAX_ATTEMPTS=3
REQUIRE_REALTIME_ASR_CONSENT=true
REQUIRE_RECORDING_CONSENT=true
RECORDING_AUDIO_QUEUE_MAX_FRAMES=5000
RECORDING_SILENCE_SPLIT_MS=800
RECORDING_SILENCE_THRESHOLD=256
RECORDING_MAX_SEGMENT_SECONDS=300
AUDIO_RETENTION_HOURS=24

# Realtime speech, playback, and deterministic Meeting settings.
REALTIME_ASR_PROVIDER=sensevoice
REALTIME_ASR_MODEL=iic/SenseVoiceSmall
REALTIME_ASR_MODEL_REVISION=master
REALTIME_ASR_MODEL_SHA256=833ca2dcfdf8ec91bd4f31cfac36d6124e0c459074d5e909aec9cabe6204a3ea
REALTIME_ASR_VAD_MODEL=fsmn-vad
REALTIME_ASR_VAD_MODEL_REVISION=v2.0.4
REALTIME_ASR_VAD_MODEL_SHA256=b3be75be477f0780277f3bae0fe489f48718f585f3a6e45d7dd1fbb1a4255fc5
REALTIME_ASR_LANGUAGE_MODE=auto
REALTIME_ASR_HOTWORDS=聆序,GRS Studio
REALTIME_ASR_TIMEOUT_SECONDS=8
REALTIME_ASR_MAX_CONCURRENCY=1
REALTIME_ASR_QUEUE_MAX_FRAMES_PER_USER=500
REALTIME_ASR_QUEUE_MAX_UTTERANCES=32
REALTIME_ASR_VAD_THRESHOLD=500
REALTIME_ASR_VAD_START_MS=60
REALTIME_ASR_VAD_END_MS=800
REALTIME_ASR_MIN_UTTERANCE_MS=300
REALTIME_ASR_MAX_UTTERANCE_SECONDS=30
# Ephemeral wake assistant. Caller PCM/question text are never persisted by this path.
MEETING_ASSISTANT_ENABLED=true
MEETING_ASSISTANT_WAKE_PHRASE=呼叫指挥中心
MEETING_ASSISTANT_WAKEWORD_MODEL_DIR=models/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20
MEETING_ASSISTANT_WAKEWORD_MODEL_DIGEST=9604d8412a76c099ef8eecedb95fa04d523cb16df2f6a6be724bc956a92870ef
MEETING_ASSISTANT_WAKEWORD_SCORE=1.5
MEETING_ASSISTANT_WAKEWORD_THRESHOLD=0.18
MEETING_ASSISTANT_QUEUE_MAX_FRAMES_PER_USER=500
MEETING_ASSISTANT_QUEUE_MAX_UTTERANCES=64
MEETING_ASSISTANT_KWS_WINDOW_MS=4000
MEETING_ASSISTANT_KWS_HOP_MS=500
MEETING_ASSISTANT_KWS_MIN_WINDOW_MS=1200
MEETING_ASSISTANT_KWS_PREROLL_MS=300
MEETING_ASSISTANT_VAD_THRESHOLD=500
MEETING_ASSISTANT_VAD_START_MS=60
MEETING_ASSISTANT_VAD_END_MS=800
MEETING_ASSISTANT_MIN_UTTERANCE_MS=300
MEETING_ASSISTANT_MAX_UTTERANCE_SECONDS=30
MEETING_ASSISTANT_FOLLOWUP_SECONDS=4
MEETING_ASSISTANT_QUARANTINE_MS=600
MEETING_ASSISTANT_ASR_TIMEOUT_SECONDS=8
MEETING_ASSISTANT_LLM_BASE_URL=http://lingxu-ollama:11434/v1
MEETING_ASSISTANT_LLM_API_KEY=
MEETING_ASSISTANT_LLM_MODEL=qwen3.5:9b
MEETING_ASSISTANT_LLM_MODEL_DIGEST=6488c96fa5faab64bb65cbd30d4289e20e6130ef535a93ef9a49f42eda893ea7
MEETING_ASSISTANT_LLM_TIMEOUT_SECONDS=30
MEETING_ASSISTANT_LLM_MAX_OUTPUT_TOKENS=64
MEETING_ASSISTANT_MAX_QUESTION_CHARS=500
MEETING_ASSISTANT_LLM_ALLOW_REMOTE=false
RESIDENT_ASSISTANT_ENABLED=true
RESIDENT_ASSISTANT_RECOVER_ON_RESTART=true
RESIDENT_ASSISTANT_MAX_SESSIONS=1
TTS_PROVIDER=cosyvoice-sft
TTS_BINARY=espeak-ng
TTS_BASE_URL=http://lingxu-tts:50000
TTS_MODEL=FunAudioLLM/CosyVoice-300M-SFT
TTS_MODEL_REVISION=fbb71de2afe387ed854eebd80b9f3d078c6b9869
TTS_MODEL_DIGEST=3a80af814cfd832dadbf1fe677adf08e30f64b8bdcd52b997184515fb33d2198
TTS_VOICE=中文女
TTS_SPEED=1.0
TTS_TIMEOUT_SECONDS=60
TTS_CACHE_DIR=data/tts_cache
TTS_PLAYBACK_VOLUME=0.8
TTS_ECHO_DEBOUNCE_MS=350
MEETING_EVENT_SNAPSHOT_INTERVAL=50
MEETING_RECOVERY_ENABLED=true
RULE_INTENTS_ENABLED=true
LLM_INTENTS_ENABLED=false
LLM_BASE_URL=http://lingxu-ollama:11434/v1
# Ollama ignores this key, but the adapter also supports authenticated local-compatible servers.
LLM_API_KEY=
LLM_MODEL=qwen3.5:9b
# Approved Ollama manifest; Lingxu refuses a mismatched local model.
LLM_MODEL_DIGEST=6488c96fa5faab64bb65cbd30d4289e20e6130ef535a93ef9a49f42eda893ea7
LLM_INTENT_CONFIDENCE_THRESHOLD=0.80
LLM_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=64
LLM_MAX_UTTERANCE_CHARS=1000
# Keep false for the selected local-only deployment.
LLM_ALLOW_REMOTE=false
AGENDA_IMPORT_LLM_ENABLED=true
AGENDA_IMPORT_LLM_BASE_URL=http://lingxu-ollama:11434/v1
AGENDA_IMPORT_LLM_API_KEY=
AGENDA_IMPORT_LLM_MODEL=qwen3.5:9b
# Owner-selected M1 Q4_K_M Ollama manifest for P2 Markdown agenda import.
AGENDA_IMPORT_LLM_MODEL_DIGEST=6488c96fa5faab64bb65cbd30d4289e20e6130ef535a93ef9a49f42eda893ea7
AGENDA_IMPORT_LLM_TIMEOUT_SECONDS=180
AGENDA_IMPORT_LLM_MAX_OUTPUT_TOKENS=1536
AGENDA_IMPORT_MAX_ATTACHMENT_BYTES=65536
AGENDA_IMPORT_MAX_SOURCE_CHARS=30000
AGENDA_IMPORT_MAX_BLOCKS=400
AGENDA_IMPORT_MAX_CHUNK_CHARS=2500
AGENDA_IMPORT_MAX_CHUNKS=12
AGENDA_IMPORT_MAX_ITEMS=50
AGENDA_IMPORT_CONFIDENCE_THRESHOLD=0.65
AGENDA_IMPORT_DEFAULT_DURATION_MINUTES=15
AGENDA_IMPORT_DEFAULT_VOTE_SECONDS=60
AGENDA_IMPORT_LLM_ALLOW_REMOTE=false
SUMMARY_LLM_ENABLED=true
# This is the Worker's fixed post-meeting DeepSeek capability and must remain enabled. Keep the API
# key blank here. On Windows, store it with scripts/set_deepseek_api_key.ps1 so the one-click
# launcher can decrypt it only into its process environment.
# Bare Docker Compose cannot read DPAPI: supply SUMMARY_LLM_API_KEY separately for manual startup.
# 手动 Compose 不会读取 DPAPI；必须另行提供密钥。Docker 管理员可查看容器中的凭据。
SUMMARY_LLM_BASE_URL=https://api.deepseek.com
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_MODEL=deepseek-flash
SUMMARY_LLM_MODEL_DIGEST=4a87243abc84b3147f3e9c2fc3416e539ae1ebd634706612996fc62018d32a0f
SUMMARY_LLM_TIMEOUT_SECONDS=1200
SUMMARY_LLM_MAX_OUTPUT_TOKENS=32768
SUMMARY_FINAL_MINUTES_MAX_OUTPUT_TOKENS=131072
SUMMARY_LLM_MAX_INPUT_CHARS=6000
SUMMARY_LLM_ALLOW_REMOTE=true
# Local-only Host console. When the token is blank, Lingxu derives a separate login token from
# FILE_ENCRYPTION_KEY; run `python -m lingxu.console.token` inside the Bot container to reveal it.
HOST_CONSOLE_ENABLED=false
HOST_CONSOLE_BIND_HOST=127.0.0.1
HOST_CONSOLE_PORT=8765
HOST_CONSOLE_TOKEN=
# Only this Guild is addressable by the console. Required when the console is enabled and
# DISCORD_TEST_GUILD_ID is blank for production global command sync.
HOST_CONSOLE_GUILD_ID=
DEFAULT_SPEAKER_SECONDS=180
DEFAULT_VOTE_SECONDS=60
DEFAULT_DISCUSSION_SECONDS=900
